# frozen_string_literal: true

require 'fileutils'

MODULE_NAME_PLACEHOLDER = '__MODULENAME__'
DATE_PLACEHOLDER = '__DATEIDENTIFIER__'
APP_MODULES_FILE = 'Tuist/ProjectDescriptionHelpers/AppModules.swift'
APP_MODULES_MARKER = '// makeFramework:insert'

platform :ios do
  desc "Creates a new framework module under Modules/ and links it into the app

#### Parameters
  * frameworkName - UpperCamelCase module name (required)

#### Example
  bundle exec fastlane makeFramework frameworkName:MyNewModule"
  lane :makeFramework do |options|
    name = options[:frameworkName].to_s
    UI.user_error!('frameworkName is required, e.g. frameworkName:MyModule') if name.empty?
    UI.user_error!('frameworkName must be UpperCamelCase letters and digits') unless name.match?(/\A[A-Z][A-Za-z0-9]*\z/)

    root = File.expand_path('..', Dir.pwd)
    destination = File.join(root, 'Modules', name)
    UI.user_error!("Module '#{name}' already exists at #{destination}") if Dir.exist?(destination)

    FileUtils.cp_r(File.join(Dir.pwd, 'Templates', 'ModuleTemplate'), destination)
    FileUtils.mkdir_p(File.join(destination, 'Sources', 'Interfaces'))
    FileUtils.mkdir_p(File.join(destination, 'Sources', 'Common'))

    Dir.glob(File.join(destination, '**', "*#{MODULE_NAME_PLACEHOLDER}*")).each do |path|
      renamed = File.join(File.dirname(path), File.basename(path).gsub(MODULE_NAME_PLACEHOLDER, name))
      FileUtils.mv(path, renamed)
    end

    today = Time.now.strftime('%x')
    Dir.glob(File.join(destination, '**', '*')).select { |path| File.file?(path) }.each do |path|
      content = File.read(path)
      updated = content.gsub(MODULE_NAME_PLACEHOLDER, name).gsub(DATE_PLACEHOLDER, today)
      File.write(path, updated) if updated != content
    end

    registry = File.join(root, APP_MODULES_FILE)
    content = File.read(registry)
    UI.user_error!("Marker '#{APP_MODULES_MARKER}' not found in #{APP_MODULES_FILE}") unless content.include?(APP_MODULES_MARKER)
    File.write(registry, content.sub(APP_MODULES_MARKER, ".module(\"#{name}\"),\n    #{APP_MODULES_MARKER}"))

    UI.success("Module '#{name}' created and linked into the app.")
    UI.message('Next: bundle exec fastlane generate_project')
  end
end
