# frozen_string_literal: true

require 'yaml'

import 'Modulefile'

default_platform(:ios)

PROJECT_NAME = '__PROJECTNAMEIDENTIFIER__'
WORKSPACE = "#{PROJECT_NAME}.xcworkspace"
TEST_SCHEME = "#{PROJECT_NAME}-Workspace" # Tuist's workspace scheme: every target and test bundle
APP_SCHEME = PROJECT_NAME

platform :ios do
  def message(text)
    UI.message("⚙️ #{text}")
  end

  # Runs a Tuist command from the project root with the version pinned in .mise.toml.
  def tuist(command, env = {})
    Dir.chdir('..') do
      exports = env.map { |key, value| "#{key}=#{value}" }.join(' ')
      sh "#{exports} mise exec -- tuist #{command}".strip
    end
  end

  # MARKETING_VERSION and CURRENT_PROJECT_VERSION come from the `version` file.
  def version_env
    marketing, build = File.read('../version').split
    { 'TUIST_MARKETING_VERSION' => marketing, 'TUIST_BUILD_NUMBER' => build }
  end

  desc "Fetches dependencies and generates the workspace

#### Optional parameters
  * open: true - Open the workspace after generation"
  lane :generate_project do |options|
    message('Fetching external dependencies')
    tuist('install')
    message('Generating workspace')
    tuist('generate --no-open', version_env)
    open_project if options[:open].nil? || options[:open]
  end

  desc 'Opens the workspace'
  lane :open_project do
    Dir.chdir('..') { sh "open #{WORKSPACE}" }
  end

  desc "Generates the workspace and runs every test bundle

#### Optional parameters
  * open: true - Open the test results after running tests"
  lane :test_project do |options|
    generate_project(open: false)
    # xcodebuild refuses to overwrite an existing result bundle.
    Dir.chdir('..') { FileUtils.rm_rf(['TestResults', 'TestResults.xcresult']) }
    actions_config = YAML.load_file('../.actions.yml')
    begin
      # https://docs.fastlane.tools/actions/run_tests/#parameters
      setup_ci if ENV['CI']
      run_tests(
        workspace: WORKSPACE,
        scheme: TEST_SCHEME,
        device: actions_config['test_device'].to_s,
        derived_data_path: './build_data',
        result_bundle_path: 'TestResults.xcresult'
      )
    ensure
      sh 'open ../TestResults.xcresult' if options[:open].nil? || options[:open]
    end
  end

  desc "Builds a simulator .xcarchive of the app

#### Optional parameters
  * open: true - Open the archive after generation"
  lane :generate_app do |options|
    generate_project(open: false)
    archive_path = File.expand_path("../build/#{PROJECT_NAME}-iossimulator.xcarchive", Dir.pwd)
    # https://docs.fastlane.tools/actions/build_app/#parameters
    setup_ci if ENV['CI']
    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      configuration: 'Release',
      derived_data_path: './build_data',
      archive_path: archive_path,
      destination: 'generic/platform=iOS Simulator',
      skip_package_ipa: true,
      skip_codesigning: true
    )
    sh "open #{archive_path}" if options[:open].nil? || options[:open]
  end

  desc 'Removes generated projects and build output'
  lane :clean_project do
    tuist('clean')
    Dir.chdir('..') do
      sh "find . -maxdepth 3 \\( -name '*.xcodeproj' -o -name '*.xcworkspace' \\) -not -path './Tuist/*' -exec rm -rf {} +"
      sh 'rm -rf Derived build build_data TestResults TestResults.xcresult'
    end
  end

  desc 'Runs SwiftLint over the app and modules'
  lane :lint_project do
    Dir.chdir('..') { sh './Scripts/lint.sh' }
  end
end
